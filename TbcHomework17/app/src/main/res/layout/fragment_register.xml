<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.RegisterFragment">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_top_ellipse"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_register"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="92dp"
        android:text="@string/register"
        android:textAppearance="@style/Register"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="46dp"
        android:layout_marginTop="43dp"
        android:layout_marginEnd="41dp"
        android:src="@drawable/ic_main_register_in_fragment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_register" />


    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_bottom_ellipse"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.appcompat.widget.AppCompatEditText
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="@string/email"
        android:background="@drawable/background_btn_log_in"
        android:layout_marginHorizontal="30dp"
        android:id="@+id/edEmail"
        android:textSize="24sp"
        android:drawableStart="@drawable/ic_email"
        android:paddingStart="33dp"
        android:paddingEnd="43dp"
        android:drawablePadding="40dp"
        android:textColorHint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivRegister"
        android:layout_marginTop="56dp"
        />

    <androidx.appcompat.widget.AppCompatEditText
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="@string/username"
        android:background="@drawable/background_btn_log_in"
        android:layout_marginHorizontal="30dp"
        android:id="@+id/edUserName"
        android:textSize="24sp"
        android:drawableStart="@drawable/ic_user"
        android:paddingStart="33dp"
        android:paddingEnd="43dp"
        android:drawablePadding="40dp"
        android:textColorHint="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edEmail"
        android:layout_marginTop="44dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:endIconMode="password_toggle"
        app:passwordToggleEnabled="false"
        app:layout_constraintTop_toBottomOf="@+id/edUserName"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="33dp"
        app:hintEnabled="false">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingVertical="10dp"
            android:layout_marginHorizontal="33dp"
            android:drawableStart="@drawable/ic_lock"
            android:hint="@string/password"
            android:textColorHint="@color/white"
            android:textSize="24sp"
            android:paddingStart="33dp"
            android:paddingEnd="43dp"
            android:drawablePadding="40dp"
            android:background="@drawable/background_btn_log_in"/>

    </com.google.android.material.textfield.TextInputLayout>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/register"
        android:textAppearance="@style/Register_login"
        android:layout_marginHorizontal="33dp"
        android:background="@drawable/background_btn_register"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="47dp"
        app:layout_constraintTop_toBottomOf="@+id/textInputLayoutPassword"/>

</androidx.constraintlayout.widget.ConstraintLayout>